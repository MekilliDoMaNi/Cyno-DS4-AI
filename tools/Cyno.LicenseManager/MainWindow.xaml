<Window x:Class="Cyno.LicenseManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cyno License Manager — solo proprietario" Width="850" Height="740" MinWidth="750" MinHeight="650" Background="#090D17" Foreground="#EAF3FF" FontFamily="Segoe UI" FontSize="13"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock Text="CYNO / LICENSE MANAGER" FontSize="28" FontFamily="Bahnschrift" Foreground="#32F6FF"/><TextBlock Text="STRUMENTO DEL PROPRIETARIO — NON INSERIRE NELLO ZIP PUBBLICO" Style="{StaticResource Caption}" Margin="0,10,0,18"/><TextBlock x:Name="AuthorityStatus" Foreground="#F3ED6B" Margin="0,0,0,18"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AUTORIZZA UN PC" Style="{StaticResource Heading}"/><Button Content="1. APRI RICHIESTA .CYNOREQUEST" Click="OpenRequest_Click"/><TextBlock x:Name="RequestInfo" Text="Nessuna richiesta selezionata." FontFamily="Consolas" Foreground="#8C9BB5" Margin="0,6,0,12"/><TextBlock Text="Nome del cliente o del PC"/><TextBox x:Name="Customer" Text="PC autorizzato" MaxLength="200"/><WrapPanel><CheckBox x:Name="Permanent" Content="Senza scadenza" IsChecked="True"/><DatePicker x:Name="Expiry" Width="160" Margin="12,4,0,14"/></WrapPanel><TextBlock Text="Se usi una scadenza, la licenza termina alla fine della data scelta secondo il fuso locale." Foreground="#8C9BB5" FontSize="11" Margin="0,0,0,12"/><Button x:Name="Generate" Content="2. GENERA LICENZA FIRMATA" Click="Generate_Click" Style="{StaticResource Primary}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BACKUP DELLA CHIAVE PRIVATA" Style="{StaticResource Caption}"/><TextBlock Text="Conserva il backup cifrato e la password separati. Senza la chiave non potrai creare nuove licenze compatibili con questa build." Foreground="#8C9BB5" Margin="0,0,0,12"/><PasswordBox x:Name="BackupPassword" Background="#0C1422" Foreground="#EAF3FF" Padding="10" Margin="0,0,0,14"/><WrapPanel><Button Content="ESPORTA BACKUP CIFRATO" Click="Backup_Click"/><Button Content="RIPRISTINA BACKUP" Click="Restore_Click"/></WrapPanel></StackPanel></Border><TextBlock x:Name="Result" Foreground="#32F6FF"/></StackPanel></ScrollViewer></Window>
