<Window x:Class="OpenDS4AI.App.ActivationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cyno DS4.AI — Attivazione richiesta" Width="760" Height="610" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#090D17" Foreground="#EAF3FF" FontFamily="Segoe UI" FontSize="13"><Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="CYNO DS4.AI" FontFamily="Bahnschrift" FontSize="34" Foreground="#32F6FF"/><TextBlock Text="ATTIVAZIONE / PC AUTORIZZATI" Style="{StaticResource Caption}" Margin="0,10,0,20"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" BorderBrush="#933965"><StackPanel><TextBlock Text="Licenza richiesta" Style="{StaticResource Heading}"/><TextBlock x:Name="ActivationStatus" Foreground="#FF65B9"/><TextBlock Text="Il controller e la visione restano disattivati finché la licenza non è valida." Foreground="#8C9BB5" Margin="0,12,0,0"/></StackPanel></Border><StackPanel Grid.Row="2"><TextBlock Text="CODICE PC / PROFILO WINDOWS" Style="{StaticResource Caption}"/><TextBox x:Name="DeviceCode" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"/><TextBlock x:Name="DeviceProtection" Foreground="#8C9BB5" FontSize="11" Margin="0,0,0,16"/></StackPanel><WrapPanel Grid.Row="3"><Button Content="1. ESPORTA RICHIESTA" Click="ExportRequest_Click"/><Button Content="2. IMPORTA LICENZA" Click="ImportLicense_Click" Style="{StaticResource Primary}"/></WrapPanel><TextBlock Grid.Row="4" Text="Invia il file .cynorequest al proprietario di Cyno DS4.AI. Riceverai un file .cynolicense da importare qui. Una licenza di un altro PC non attiva questa installazione." Foreground="#8C9BB5" Margin="0,18,0,0"/></Grid></Window>
